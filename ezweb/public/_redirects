# Netlify / Cloudflare Pages redirects. Keep in sync with retiredServiceRedirects in src/services.tsx
# (npm run check:seo fails the build if an entry is missing).
#
# Unknown paths: both hosts serve /404.html with HTTP 404 automatically. There is intentionally
# NO SPA catch-all (/* /index.html 200); every real route is prerendered to its own file.

# www -> apex (Netlify; Cloudflare Pages ignores domain-level lines, use a Bulk Redirect there)
https://www.ezweb.dev/* https://ezweb.dev/:splat 301!
http://www.ezweb.dev/* https://ezweb.dev/:splat 301!

